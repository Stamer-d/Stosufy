{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Stosufy",
	"version": "0.6.63",
	"identifier": "com.Stosufy.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:2021",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["stosufynew"]
			}
		},
		"fs": {
			"requireLiteralLeadingDot": false
		},
		"updater": {
			"windows": {
				"installerType": "nsis"
			},
			"active": true,
			"endpoints": ["https://github.com/Stamer-d/Stosufy/releases/latest/download/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNUFDM0M5N0EyODJEMTAKUldRUUxTaDZ5Y05hUW5TK1k2ZDY5Ykd3OExVZkJBaW1Eb0ovVEVJQXNrZmpXbUZvZUxSRHhhYjgK"
		}
	},
	"app": {
		"windows": [
			{
				"decorations": false,
				"dragDropEnabled": false,
				"additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=HardwareMediaKeyHandling",
				"title": "Stosufy",
				"width": 800,
				"height": 600,
				"minHeight": 600,
				"minWidth": 800
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self' 'wasm-unsafe-eval' blob:",
				"worker-src": "'self' blob:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"img-src": "'self' data: blob: asset: http://asset.localhost https: http:",
				"media-src": "'self' data: blob: asset: http://asset.localhost https: http:",
				"connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https: wss:",
				"frame-src": "https:",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'"
			},
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": [
						"$HOME/Stosufy",
						"$HOME/Stosufy/**",
						"$LOCALDATA/osu!",
						"$LOCALDATA/osu!/**",
						"$HOME/.local/share/osu-wine/**",
						"$HOME/.local/share/osu-stable/**",
						"$HOME/osu!/**",
						"$HOME/Games/osu!/**",
						"$HOME/Applications/osu!.app/**",
						"$HOME/Library/Containers/com.isaacmarovitz.Whisky/Bottles",
						"$HOME/.wine/drive_c/osu!/**",
						"$HOME/.wine/drive_c/users/*/AppData/Local/osu!/**",
						"$HOME/.wine/drive_c/Program Files/osu!/**",
						"$HOME/Games/osu/prefix/drive_c/osu!/**",
						"$HOME/Games/osu/prefix/drive_c/users/*/AppData/Local/osu!/**",
						"$HOME/Games/osu/prefix/drive_c/Program Files/osu!/**",
						"$HOME/.local/share/bottles/bottles/osu/drive_c/osu!/**",
						"$HOME/.local/share/bottles/bottles/osu/drive_c/users/*/AppData/Local/osu!/**",
						"$HOME/.local/share/bottles/bottles/osu/drive_c/Program Files/osu!/**",
						"$HOME/Library/Application Support/osu-wine/drive_c/osu!/**",
						"$HOME/Library/Application Support/osu-wine/drive_c/users/*/AppData/Local/osu!/**",
						"$HOME/Library/Application Support/osu-wine/drive_c/Program Files/osu!/**",
						"$HOME/Library/Containers/com.isaacmarovitz.Whisky/Bottles/*/drive_c/osu!/**",
						"$HOME/Library/Containers/com.isaacmarovitz.Whisky/Bottles/*/drive_c/users/*/AppData/Local/osu!/**",
						"$HOME/Library/Containers/com.isaacmarovitz.Whisky/Bottles/*/drive_c/Program Files/osu!/**"
					],
					"requireLiteralLeadingDot": false
				}
			}
		}
	},
	"bundle": {
		"createUpdaterArtifacts": true,
		"active": true,
		"targets": "all",
		"linux": {
			"deb": {
				"depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
			},
			"rpm": {
				"depends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
			},
			"appimage": {
				"bundleMediaFramework": true
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
