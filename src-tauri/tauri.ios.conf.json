{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"windows": [
			{
				"title": "Stosufy",
				"dragDropEnabled": false
			}
		],
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["$DOCUMENT/Stosufy", "$DOCUMENT/Stosufy/**"],
					"requireLiteralLeadingDot": false
				}
			}
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [{ "scheme": ["stosufynew"], "appLink": false }]
		}
	}
}
