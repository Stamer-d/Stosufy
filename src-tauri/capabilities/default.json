{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"drpc:default",
		"drpc:allow-is-running",
		"drpc:allow-set-activity",
		"drpc:allow-spawn-thread",
		"drpc:allow-clear-activity",
		"global-shortcut:allow-is-registered",
		"global-shortcut:allow-register",
		"global-shortcut:allow-unregister",
		"core:default",
		"opener:default",
		"http:default",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://*.tauri.app"
				},
				{
					"url": "https://osu.ppy.sh/*"
				},
				{
					"url": "https://assets.ppy.sh/*"
				},
				{
					"url": "https://api.stamer-d.de/*"
				},
				{
					"url": "https://lrclib.net/*"
				},
				{
					"url": "https://api.github.com/repos/ppy/osu-resources/*"
				},
				{
					"url": "https://raw.githubusercontent.com/ppy/osu-resources/*"
				},
				{
					"url": "https://api.rainviewer.com/*"
				},
				{
					"url": "https://tilecache.rainviewer.com/*"
				},
				{
					"url": "https://api.brightsky.dev/*"
				},
				{
					"url": "https://api.airplanes.live/*"
				},
				{
					"url": "https://api.adsb.lol/*"
				},
				{
					"url": "https://get.geojs.io/*"
				},
				{
					"url": "https://maps.dwd.de/*"
				},
				{
					"url": "https://api.adsbdb.com/*"
				},
				{
					"url": "https://api.planespotters.net/*"
				},
				{
					"url": "https://globe.airplanes.live/*"
				},
				{
					"url": "https://globe.adsb.lol/*"
				},
				{
					"url": "https://adsb.lol/*"
				},
				{
					"url": "https://globe.adsb.fi/*"
				}
			],
			"deny": [
				{
					"url": "https://private.tauri.app"
				}
			]
		},
		"websocket:default",
		"store:default",
		"shell:default",
		"deep-link:default",
		"fs:default",
		"dialog:allow-open",
		{
			"identifier": "fs:allow-home-read",
			"allow": [{ "path": "$HOME/**" }],
			"deny": [
				{ "path": "$HOME/.ssh/**" },
				{ "path": "$HOME/.gnupg/**" },
				{ "path": "$HOME/.aws/**" }
			]
		},
		{
			"identifier": "fs:allow-home-write",
			"allow": [{ "path": "$HOME/Stosufy/**" }]
		},
		{
			"identifier": "fs:allow-temp-read",
			"allow": [{ "path": "$TEMP/**" }]
		},
		{
			"identifier": "fs:allow-temp-write",
			"allow": [{ "path": "$TEMP/**" }]
		},
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"updater:default",
		"process:default",
		"process:allow-restart",
		"window-state:default"
	]
}
