{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"http:default",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://*.tauri.app"
				},
				{
					"url": "https://osu.ppy.sh/*"
				},
				{
					"url": "https://assets.ppy.sh/*"
				},
				{
					"url": "https://api.stamer-d.de/*"
				},
				{
					"url": "https://lrclib.net/*"
				},
				{
					"url": "https://api.github.com/repos/ppy/osu-resources/*"
				},
				{
					"url": "https://raw.githubusercontent.com/ppy/osu-resources/*"
				}
			],
			"deny": [
				{
					"url": "https://private.tauri.app"
				}
			]
		},
		"store:default",
		"shell:default",
		"deep-link:default",
		"fs:default",
		"dialog:allow-open",
		{
			"identifier": "fs:allow-home-read",
			"allow": [
				{
					"path": "$HOME/**"
				}
			]
		},
		{
			"identifier": "fs:allow-home-write",
			"allow": [
				{
					"path": "$HOME/Stosufy/**"
				}
			]
		},
		{
			"identifier": "fs:allow-temp-read",
			"allow": [
				{
					"path": "$TEMP/**"
				}
			]
		},
		{
			"identifier": "fs:allow-temp-write",
			"allow": [
				{
					"path": "$TEMP/**"
				}
			]
		},
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"process:default",
		"process:allow-restart",
		{
			"identifier": "fs:allow-applocaldata-read-recursive",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				}
			]
		},
		{
			"identifier": "fs:allow-applocaldata-write-recursive",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				}
			]
		}
	]
}
