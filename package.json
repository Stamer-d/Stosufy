		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json && node scripts/check-icons.js",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"tauri": "tauri",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"license": "MIT",
